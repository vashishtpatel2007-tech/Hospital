# Copy to .env and fill in. Never commit .env, never paste keys into chat.
# Check them with:  make check-keys

# --- Required: Day 1 ---
ANTHROPIC_API_KEY=

# --- Required: Day 1 evening / Day 2 ---
SARVAM_API_KEY=
# looks like wss://<project>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Optional: Day 3 ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# --- Optional fallbacks ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# --- Local services (defaults work with docker-compose.yml) ---
DATABASE_URL=postgresql://sahay:sahay@localhost:5433/sahay
TWIN_DB_URL=sqlite:///./twin.db
TWIN_URL=http://localhost:8001
JOURNEY_URL=http://localhost:8002
# Journey store: SQLite until Docker is up, then point at DATABASE_URL
JOURNEY_DB_URL=sqlite:///./journey.db
# Change in production: salts the phone-number pseudonyms
PHI_HASH_SALT=sahay-dev-salt-change-me

# Models (conversation needs speed; judge/simulated caller can be stronger)
AGENT_MODEL=claude-haiku-5-5
AGENT_EFFORT=low
# adaptive (default) or off. Off is faster; measure before switching (Stage 10)
AGENT_THINKING=adaptive
# seconds to wait for the model's first words before one retry
AGENT_LLM_TIMEOUT=6
# simulated callers in `make scenarios`
SIM_CALLER_MODEL=claude-sonnet-5-5
HOSPITAL_NAME=Sunrise Multispeciality Hospital
# set to 1 to print every trace line while chatting
SAHAY_TRACE_STDOUT=
